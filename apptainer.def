Bootstrap: docker
From: ubuntu:22.04

%arguments
    CI_JOB_TOKEN=none

%files
    environment.yml /opt/environment.yml
    . /opt/app_src

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export ENV_NAME=topsocnww3sp
    export PATH=/opt/conda/envs/topsocnww3sp/bin:/opt/conda/bin:$PATH
    export PYTHONUNBUFFERED=1

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    export ENV_NAME=topsocnww3sp

    # Throttling to prevent memory errors
    export MAMBA_PARALLEL_PROCESSES=1
    export CONDA_MAX_THREADS=1

    # 1. System dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        curl bzip2 ca-certificates libglib2.0-0 libxext6 libsm6 libxrender1 build-essential git

    # 2. Micromamba
    mkdir -p /usr/local/bin
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | \
    tar -xj --strip-components=1 -C /usr/local/bin/ bin/micromamba

    # 3. Environment creation
    micromamba create -y -r $MAMBA_ROOT_PREFIX -n $ENV_NAME -f /opt/environment.yml --quiet

    # 4. Install the local application (generates the scripts from pyproject.toml).
    # Dependencies come from environment.yml (conda-forge) only: --no-deps.
    # hatch-vcs reads the version from git: the copied repo belongs to another uid.
    git config --global --add safe.directory /opt/app_src
    cd /opt/app_src
    /opt/conda/envs/$ENV_NAME/bin/pip install --no-deps --no-cache-dir .

    # 5. Final permissions
    chmod -R 755 /opt/conda
    chmod -R 755 /opt/app_src

    # 6. Cleanup
    micromamba clean -a -y
    apt-get purge -y curl bzip2 build-essential
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /opt/environment.yml /root/.cache

%runscript
    if [ $# -eq 0 ]; then
        echo "No command provided. Starting Python interpreter..."
        exec python
    else
        exec "$@"
    fi

%test
    which procl2c
    which procl2c-sequential
    python -c "import topsocnww3sp, shapely, netCDF4, xarray, dask, cartopy; print('topsocnww3sp', topsocnww3sp.__version__)"
    procl2c-sequential --help > /dev/null
